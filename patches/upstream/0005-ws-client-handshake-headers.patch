+void uvcpp_ws_client::set_handshake_header(const std::string& name,
+                                          const std::string& value) {
+  if (name.empty() || name.find_first_of("\r\n") != std::string::npos ||
+      value.find_first_of("\r\n") != std::string::npos) {
+    return;
+  }
+  auto iequal = [](const std::string& text, const char* word) {
+    const std::size_t size = std::strlen(word);
+    if (text.size() != size) return false;
+    for (std::size_t i = 0; i < size; ++i) {
+      if (std::tolower(static_cast<unsigned char>(text[i])) !=
+          std::tolower(static_cast<unsigned char>(word[i]))) {
+        return false;
+      }
+    }
+    return true;
+  };
+  static const char* kReserved[] = {"host", "upgrade", "connection",
+                                    "sec-websocket-key", "sec-websocket-version",
+                                    "sec-websocket-extensions"};
+  for (const char* reserved : kReserved) {
+    if (iequal(name, reserved)) return;
+  }
+  for (auto& item : handshake_headers_) {
+    if (iequal(item.first, name.c_str())) {
+      item.second = value;
+      return;
+    }
+  }
+  handshake_headers_.emplace_back(name, value);
+}
